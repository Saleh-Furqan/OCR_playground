# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-change-this-to-something-secure
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes
UPLOAD_FOLDER=uploads

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract  # Path to tesseract binary

# Database (for future use)
DATABASE_URL=sqlite:///receipts.db

# LLM API Configuration (choose one)
LLM_PROVIDER=huggingface  # Options: ollama, huggingface, groq, gemini

# Free API Keys (get from respective providers)
HUGGINGFACE_API_KEY=your-hf-token-here
GROQ_API_KEY=your-groq-key-here  
GOOGLE_API_KEY=your-google-key-here

# Model Selection per Provider
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium
GROQ_MODEL=llama3-8b-8192
GEMINI_MODEL=gemini-1.5-flash